# ============================================================
# Constellation Intelligence Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# The backend will read these values on startup via pydantic-settings.

# ---- Application ----
APP_NAME=Constellation Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true

# ---- Neo4j Graph Database ----
# If Neo4j is not running, the system auto-falls back to an embedded graph engine.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ---- SQLite Database ----
SQLITE_DB_PATH=./constellation.db

# ---- Evidence File Storage ----
EVIDENCE_STORE_DIR=./evidence_store

# ---- JWT Authentication ----
JWT_SECRET_KEY=change_this_to_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- HMAC Audit Ledger ----
# Canonical key used for the cryptographic audit hash-chain.
# For local development with seeded data, use the default below.
# In production, set a secure secret before initial seeding.
HMAC_SECRET_KEY=constellation_tamper_evident_hmac_secret_chain_key_2026

# ---- Autonomous Sweep Engine ----
SWEEP_INTERVAL_HOURS=12

# ---- LLM / AI Engine (NVIDIA NIM) ----
# Get your API key from https://build.nvidia.com
# Leave blank to use deterministic graph-based responses (no hallucination risk).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---- Ingestion & NER ----
SPACY_MODEL=en_core_web_sm

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
