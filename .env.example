# ============================================================
# Constellation Intelligence Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# The backend will read these values on startup via pydantic-settings.

# ---- Application ----
APP_NAME=Constellation Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true

# ---- Neo4j Graph Database ----
# If Neo4j is not running, the system auto-falls back to an embedded graph engine.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ---- SQLite Database ----
SQLITE_DB_PATH=./constellation.db

# ---- Evidence File Storage ----
EVIDENCE_STORE_DIR=./evidence_store

# ---- JWT Authentication ----
JWT_SECRET_KEY=change_this_to_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- HMAC Audit Ledger ----
# Canonical key used for the cryptographic audit hash-chain.
# For local development with seeded data, use the default below.
# In production, set a secure secret before initial seeding.
HMAC_SECRET_KEY=constellation_tamper_evident_hmac_secret_chain_key_2026

# ---- Autonomous Sweep Engine ----
SWEEP_INTERVAL_HOURS=12

# ---- LLM / AI Engines ----
# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEY_2=your_secondary_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# ---- Supabase Cloud Configuration ----
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PROJECT_ID=your_project_id_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ---- Cloud Deployment Configuration ----
NETLIFY_AUTH_TOKEN=your_netlify_token_here
NETLIFY_SITE_USER=your_netlify_username_here
NETLIFY_SITE_ID=your_netlify_site_id_here
VERCEL_TOKEN=your_vercel_token_here
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# ---- Ingestion & NER ----
SPACY_MODEL=en_core_web_sm

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000,https://constellation-platform.netlify.app
